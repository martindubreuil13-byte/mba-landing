# Applies only in a trusted project configuration. Provider permissions are the enforcement boundary.
prefix_rule(pattern=["git", "push"], decision="prompt", justification="Review the diff and validation with Martin before pushing an MBA feature branch.")
prefix_rule(pattern=["git", "push", ["--force", "--force-with-lease", "--mirror", "--all"]], decision="forbidden", justification="Use an approved push of the named feature branch.")
prefix_rule(pattern=["git", "push", ["origin", "https://github.com/martindubreuil13-byte/mba-landing.git"], ["main", "HEAD:main", "HEAD:refs/heads/main", ":main", "+main"]], decision="forbidden", justification="GitHub main changes through reviewed pull requests.")
prefix_rule(pattern=["gh", "pr", "merge"], decision="prompt", justification="Martin must explicitly approve this specific merge.")
prefix_rule(pattern=["gh", "api"], decision="prompt", justification="Review the exact target and HTTP method before running GitHub API requests.")
prefix_rule(pattern=["gh", "repo", ["edit", "delete"]], decision="forbidden", justification="Repository settings are managed outside development.")
prefix_rule(pattern=[["vercel", "vc"], ["deploy", "redeploy", "promote", "rollback", "alias", "link", "pull", "remove", "rm", "--prod", "--target", "--prebuilt"]], decision="forbidden", justification="Use the approved release workflow. Keep the development checkout unlinked.")
prefix_rule(pattern=[["vercel", "vc"], "env", ["pull", "add", "update", "rm", "remove"]], decision="forbidden", justification="Keep production environment values and hosted configuration out of development.")
prefix_rule(pattern=[["vercel", "vc"], "api"], decision="prompt", justification="Review the exact endpoint and method. Use read-only access in development.")
prefix_rule(pattern=["supabase", "db", ["push", "pull", "dump"]], decision="forbidden", justification="Use isolated development data and a separately approved production migration workflow.")
prefix_rule(pattern=["supabase", "db", "reset"], decision="prompt", justification="Only a disposable local database may be reset from development.")
prefix_rule(pattern=["supabase", "migration", ["repair", "up"]], decision="forbidden", justification="Use the separately approved migration workflow for remote databases.")
prefix_rule(pattern=["supabase", "functions", "deploy"], decision="forbidden", justification="Hosted functions are managed through the approved release workflow.")
prefix_rule(pattern=["supabase", "secrets", ["set", "unset"]], decision="forbidden", justification="Manage hosted secrets outside this checkout.")
prefix_rule(pattern=[["cat", "less", "head", "tail"], [".env", ".env.local", ".env.production", ".env.production.local", ".env.development.local", ".vercel/.env.production.local"]], decision="forbidden", justification="Use .env.example for variable names. Keep environment values out of agent output.")
