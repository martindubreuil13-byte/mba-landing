# Environment variables. PLACEHOLDERS ONLY: never put a real value in this file.
# Copy to .env.local for local work; set real values in the hosting provider's dashboard, per environment.
# Full explanation: docs/preview-safeguards.md

# --- Which environment is this? (fails closed; NODE_ENV never counts) ---------------------------------
# On Vercel nothing to set: production only when VERCEL_ENV=production (Vercel sets it).
# Anywhere else (local, another host) production must be asserted explicitly. Leave unset otherwise.
# APP_ENV=production | preview

# --- Database (Supabase) ------------------------------------------------------------------------------
# Production values belong ONLY to the Production environment. Preview/Development need an ISOLATED project;
# the app refuses to start data access if a non-production deployment points at the production project.
NEXT_PUBLIC_SUPABASE_URL=https://<isolated-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Only if the production project ever changes (default is built in):
# PRODUCTION_SUPABASE_PROJECT_REF=<ref>

# --- Admin ----------------------------------------------------------------------------------------------
ADMIN_EMAIL=<authorised-admin-address>

# --- Email (Resend) -----------------------------------------------------------------------------------
RESEND_API_KEY=<resend-api-key>
# Where /lets-talk inquiries are notified. Optional; defaults to martin@mindrasolutions.com.
# Outside production the email policy also requires this address to be the ADMIN_EMAIL one (see PREVIEW_EMAIL_* below).
# INQUIRY_NOTIFY_EMAIL=<mailbox that receives inquiry notifications>
# Sender for program (Transition) emails; defaults to the currently verified identity.
# PROGRAM_EMAIL_FROM="Martin Dubreuil <martin@<verified-domain>>"
# Transition routing. Do NOT use ADMIN_EMAIL for business mail: it controls who can sign in to the admin area.
#   PROGRAM_ADMIN_EMAIL = where the internal application notification goes (Reply-To = the applicant)
#   PROGRAM_REPLY_TO    = Reply-To on every applicant-facing email (booking invitation, confirmation, manual response)
# If PROGRAM_ADMIN_EMAIL is missing no internal notification is sent (recorded as failed, never redirected to ADMIN_EMAIL).
# PROGRAM_ADMIN_EMAIL=<mailbox that receives application notifications>
# PROGRAM_REPLY_TO=<mailbox applicants reply to>
# Sender for the Transition "stay connected" confirmation message; falls back to PROGRAM_EMAIL_FROM, then the default.
# CONSENT_EMAIL_FROM="Martin Dubreuil <martin@<verified-domain>>"
# Business postal address shown in the footer of consent-confirmation and delivery emails (CASL / CAN-SPAM). Shown only
# when set. Multiline: use real line breaks (quoted in .env files) or a literal \n between lines. Approved production
# value: MINDRA, Narva mnt 5, 10117 Tallinn, Estonia. Set it in the hosting dashboard, never in this file.
# MAILING_ADDRESS=<business mailing address>
# Sender for guide/resource delivery emails; defaults to the currently verified identity.
# RESOURCE_EMAIL_FROM="Martin Dubreuil <martin@<verified-domain>>"
# Signing secret of the Resend webhook that points at <deployment>/api/webhooks/resend
# RESEND_WEBHOOK_SECRET=whsec_<secret>

# --- Calendly (Transition booking tracking) -----------------------------------------------------------
# The `signing_key` chosen when the Calendly webhook subscription is created (events invitee.created and invitee.canceled,
# URL <deployment>/api/webhooks/calendly). Without it the endpoint refuses everything and the admin says "Not connected":
# no booking is ever shown as confirmed. Webhooks are a paid-plan Calendly feature. See docs/transition-booking-flow/README.md.
# CALENDLY_WEBHOOK_SIGNING_KEY=<random secret you generate, at least 32 characters>

# --- Signing / hashing secrets (stable values recommended; they fall back to the service key) --------------
# NAPKIN_UNSUBSCRIBE_SECRET=<random-32-bytes>
# EVIDENCE_HASH_SECRET=<random-32-bytes>

# --- Preview / non-production safeguards -----------------------------------------------------------------
# Email is OFF in every non-production environment unless BOTH are set. The allowlist may contain ONLY the
# ADMIN_EMAIL address; any other entry keeps email disabled. Other recipients are always rejected.
# PREVIEW_EMAIL_ENABLED=true
# PREVIEW_EMAIL_ALLOWLIST=<same address as ADMIN_EMAIL>
# Origin used in emails and API-returned links. Optional on Vercel previews (VERCEL_URL is used);
# leave UNSET in Production.
# APP_BASE_URL=https://<this-deployment-host>

# --- Local testing only ------------------------------------------------------------------------------------
# Point the Resend SDK at a local mock so "email enabled" can be tested with no real send:
# RESEND_BASE_URL=http://127.0.0.1:4010

# Password of the throwaway LOCAL admin user created by docs/resource-lead-capture/e2e/seed.mjs (any value you choose):
# LOCAL_ADMIN_PASSWORD=<throwaway-local-value>

# --- Other features --------------------------------------------------------------------------------------
OPENAI_API_KEY=<openai-api-key>
# OPENAI_CLASSIFY_MODEL=<model>
# OPENAI_INTERPRET_MODEL=<model>
# ASSESSMENT_PAID_CTA_URL=<url>

# --- Website Intelligence (first-party analytics) ----------------------------------------------------------
# Required in Production for the daily retention job: Vercel Cron sends it as "Authorization: Bearer <value>".
# Without it /api/cron/intelligence-maintenance refuses every call (retention would not run).
# CRON_SECRET=<random-32-bytes>

# Scheduling configuration (local examples; production template is documented separately)
# SCHEDULING_BACKEND=file | supabase          # persistence: local JSON file, or the database (apply supabase/migrations/20261101090000_mba_scheduling.sql first)
# SCHEDULING_GOOGLE=mock | live               # Google Calendar. live needs SCHEDULING_BACKEND=supabase and the three below
# SCHEDULING_GOOGLE_CLIENT_ID=<oauth client id>
# SCHEDULING_GOOGLE_CLIENT_SECRET=<oauth client secret>
# SCHEDULING_GOOGLE_REDIRECT_URI=<optional; default <APP_BASE_URL>/api/admin/scheduling/google/callback>
# SCHEDULING_GOOGLE_INVITE_GUEST=true         # optional: also let Google email the guest an invitation (default off; our branded email is the notification)
# SCHEDULING_GOOGLE_CHANNEL_TOKEN=<random>    # only if Google push notifications are enabled (/api/webhooks/scheduling/google)
# SCHEDULING_TOKEN_KEY=<openssl rand -base64 32>   # encrypts the stored Google refresh token (AES-256-GCM). Losing it means reconnecting Google
# SCHEDULING_TOKEN_KEY_VERSION=1              # bump when rotating; keep the old key as ..._PREVIOUS (+ _PREVIOUS_VERSION) until values are re-encrypted
# SCHEDULING_ZOOM=mock | live                 # Zoom (Server-to-Server OAuth app)
# SCHEDULING_ZOOM_ACCOUNT_ID=<zoom account id>
# SCHEDULING_ZOOM_CLIENT_ID=<zoom client id>
# SCHEDULING_ZOOM_CLIENT_SECRET=<zoom client secret>
# SCHEDULING_ZOOM_USER_ID=<the host's Zoom user id or email>   # required: S2S OAuth cannot use "me"
# SCHEDULING_ZOOM_WEBHOOK_SECRET=<zoom app "Secret Token">       # /api/webhooks/scheduling/zoom
# SCHEDULING_SYNC=background | inline        # background (default): Zoom, Google and email run after the response (Next after()). inline: wait for them (scripts, debugging)
# SCHEDULING_EMAIL=simulated | resend         # booking emails. resend uses RESEND_API_KEY through the existing policy-checked client
# SCHEDULING_EMAIL_TEST_MODE=true             # LOCAL DEV ONLY (.env.development.local, never a shared or hosted environment): with SCHEDULING_EMAIL=resend, real booking emails go ONLY to the one developer test address
#                                              # hard-coded in app/lib/email-policy.ts; every other recipient is simulated. Ignored on Vercel, in production and preview, in builds and under `next start`.
# (There is no SCHEDULING_OWNER_EMAIL setting: host notifications go only to the approved address built into app/lib/scheduling/owner-address.ts. Setting the variable to any other address makes the app refuse to start.)
# SCHEDULING_EMAIL_FROM=Martin Dubreuil <martin@mindrasolutions.com>   # optional; defaults to RESOURCE_EMAIL_FROM or this address
# SCHEDULING_EMAIL_REPLY_TO=<optional>
# SCHEDULING_RESEND_WEBHOOK_SECRET=<whsec_...>   # a SECOND Resend webhook pointed at /api/webhooks/scheduling/resend (the existing one is untouched)
# CRON_SECRET (existing) protects /api/cron/scheduling-sync, the retry worker

# Production Scheduling (Production scope only; all default OFF)
# SCHEDULING_OPERATIONS_ENABLED=false
# SCHEDULING_PUBLIC_INTAKE_ENABLED=false
# SCHEDULING_RECOVERY_SECRET=<dedicated random secret, never the site-wide CRON_SECRET>
